<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
{{#if active}}
<nav class="navbar navbar-expand navbar-dark bg-dark px-3">
  <a class="navbar-brand" href="/category">Admin</a>
  <ul class="navbar-nav me-auto">
    <li class="nav-item"><a class="nav-link {{#if (eq active 'category')}}active{{/if}}" href="/category">Categories</a></li>
    <li class="nav-item"><a class="nav-link {{#if (eq active 'item')}}active{{/if}}" href="/item">Items</a></li>
  </ul>
  <form action="/auth/logout" method="POST"><button class="btn btn-outline-light btn-sm">Logout</button></form>
</nav>
{{/if}}
<main class="container my-4">
  {{#if error}}<div class="alert alert-danger">{{error}}</div>{{/if}}
  {{{body}}}
</main>
</body>
</html>