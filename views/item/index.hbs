<div class="d-flex justify-content-between mb-3">
  <h3>Items</h3>
  <a href="/item/create" class="btn btn-success">+ Create</a>
</div>

<form method="GET" action="/item" class="input-group mb-3">
  <input class="form-control" name="q" value="{{q}}" placeholder="Search item or category...">
  <button class="btn btn-outline-secondary">Search</button>
</form>

<table class="table table-striped align-middle">
  <thead><tr><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th style="width:200px">Actions</th></tr></thead>
  <tbody>
  {{#each items}}
    <tr>
      <td>{{this.name}}</td>
      <td>{{this.kategori_name}}</td>
      <td>{{this.price}}</td>
      <td>{{this.stock}}</td>
      <td class="d-flex gap-2">
        <a href="/item/{{this.id}}/edit" class="btn btn-sm btn-warning">Update</a>
        <form action="/item/{{this.id}}/delete" method="POST">
          <button class="btn btn-sm btn-danger">Delete</button>
        </form>
      </td>
    </tr>
  {{else}}
    <tr><td colspan="5" class="text-center text-muted">No data</td></tr>
  {{/each}}
  </tbody>
</table>