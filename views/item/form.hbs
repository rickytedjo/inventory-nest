<h3>{{title}}</h3>
<form action="{{action}}" method="POST" style="max-width:500px">
  <div class="mb-3">
    <label class="form-label">Name</label>
    <input class="form-control" name="name" value="{{item.name}}" required>
  </div>
  <div class="mb-3">
    <label class="form-label">Category</label>
    <select class="form-select" name="kategori_id" required>
      <option value="">-- choose --</option>
      {{#each categories}}
        <option value="{{this.id}}" {{#if (eq this.id ../item.kategori_id)}}selected{{/if}}>{{this.name}}</option>
      {{/each}}
    </select>
  </div>
  <div class="row">
    <div class="col mb-3"><label class="form-label">Price</label>
      <input class="form-control" type="number" name="price" value="{{item.price}}"></div>
    <div class="col mb-3"><label class="form-label">Stock</label>
      <input class="form-control" type="number" name="stock" value="{{item.stock}}"></div>
  </div>
  <button class="btn btn-primary">Save</button>
  <a href="/item" class="btn btn-link">Cancel</a>
</form>